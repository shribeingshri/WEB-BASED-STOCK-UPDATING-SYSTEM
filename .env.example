# Server Configuration
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:3000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=buildmore_inventory

# Authentication & Security
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_32_chars
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
BCRYPT_ROUNDS=10

# Company Defaults
COMPANY_NAME=Buildmore Ventures LLP

